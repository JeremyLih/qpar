# Environment, caches, editor and OS files
/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.idea/
.vscode/
.ipynb_checkpoints/
.DS_Store

# MNIST and Fashion-MNIST: torchvision downloads them into data/ on first use
/data/

# Model weights and resume state (regenerated by training). GitHub rejects files over
# 100 MB; with these excluded, no tracked file is larger than 2 MB.
*.pt
/results/checkpoints/
/results/partial/
/results/smoke/checkpoints/

# Cloud-run state written by the coordinator; it holds local paths, the SSH key path and
# instance IP addresses (results/README.md lists what is kept)
/.fleet/
/results/fleet/fleet_state.json
/results/fleet/step1.json
/results/logs/coordinator.log
/results/logs/fleet_events.log

# Working notes, not study outputs
/results/RESULTS_BRIEF.md
/results/figures/brief/
/results/figures/Claude outputs/

# Paper: what paper/build.sh generates, LaTeX auxiliary files, and the IEEE Access template files,
# which are not redistributed (paper/README.md)
/paper/tables/tab0[2-7]_*.tex
/paper/tables/tabS*.tex
/paper/figures/*.pdf
/paper/figures/*.png
/paper/*.pdf
/paper/*.bbl
/paper/*.blg
/paper/**/*.aux
/paper/**/*.log
/paper/**/*.out
/paper/**/*.fls
/paper/**/*.fdb_latexmk
/paper/**/*.synctex.gz
/paper/*.cls
/paper/*.sty
/paper/*.bst
/paper/*.pfb
/paper/*.tfm
/paper/*.map
/paper/*.fd
/paper/*.png
